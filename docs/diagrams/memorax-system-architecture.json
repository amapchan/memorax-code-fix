  "cards": [
    {
      "dot": "cyan",
      "title": "Authority Model",
      "items": [
        "Clients own models, credentials, and native transcripts",
        "Adapters bridge events to Backend without interpreting native content",
        "Backend owns memory operations and repository scope"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data Boundaries",
      "items": [
        "Raw transcripts stay local; only normalized Search/Add crosses the provider boundary",
        "Trace and lifecycle records remain local-only",
        "Backend stays on loopback by default"
      ]
    },
    {
      "dot": "rose",
      "title": "Packaging Flow",
      "items": [
        "npm sources and adapters feed the build scripts",
        "Build stages and materializes into the installed artifact",
        "Artifact starts the Backend and invokes memory commands"
      ]
    }
  ]
