  "cards": [
    {
      "dot": "rose",
      "title": "Scope Boundary",
      "items": [
        "Repository identity 只读解析，不执行 Git",
        "Session 先绑定 workspace，再绑定 repository scope",
        "Scope 不匹配时写回显式拒绝，而不是静默换源"
      ]
    },
    {
      "dot": "emerald",
      "title": "Content Authority",
      "items": [
        "Codex Rollout 提供用户输入和助手回复",
        "Trace 是本地运行证据，不是记忆内容来源",
        "自动写回只消费匹配 Turn 的内容"
      ]
    },
    {
      "dot": "amber",
      "title": "Egress",
      "items": [
        "写回按 Session 缓冲并批量提交",
        "Memory Service 是本地运行时门面",
        "MemoraX 只收到文档化的 query/add/writeback 负载"
      ]
    }
  ]
}
