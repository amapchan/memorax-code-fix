    {
      "dot": "cyan",
      "title": "Request Flow",
      "items": [
        "CLI and HTTP entrypoints compose the app root",
        "Memory kernels call the MemoraX provider for Search and Add",
        "Repository scope pins sessions to workspace identity"
      ]
    },
    {
      "dot": "emerald",
      "title": "State Ownership",
      "items": [
        "Trace stores local client-qualified events only",
        "Repository reads Git markers without executing Git",
        "Provider adapter is the sole outbound network boundary"
      ]
    },
    {
      "dot": "rose",
      "title": "Foundation Layer",
      "items": [
        "shared supplies cross-cutting utilities to all modules",
        "adapter-common supplies shared primitives consumed by Backend and all 6 adapters",
        "Neither foundation layer imports higher-level modules"
      ]
    }
